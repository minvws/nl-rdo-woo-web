parameters:
    tmpDir: ./.phpstan.cache
    # Each generated reference declares the same App class; loading more than one causes a redeclaration.
    # The MinVWS admin reference is generated by Composer's auto-scripts in CI.
    bootstrapFiles:
        - var/cache/dev/minvws/admin/reference.php
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: true
    doctrine:
        objectManagerLoader: phpstan-doctrine-orm-bootstrap.php
    paths:
        - bin/
        - config/
        - public/
        - src/
        - tests/
        - apps/
        - tenants/
        - utils/
    excludePaths:
        - utils/tests/**/data/*
    level: max
    symfony:
        containerXmlPath: var/cache/dev/minvws/shared/Shared_KernelDevMinvwsSharedDebugContainer.xml
    faker:
        providerClasses:
            - Shared\Tests\Faker\AttachmentFakerProvider
            - Shared\Tests\Faker\BaseFakerProvider
            - Shared\Tests\Faker\DateTimeFakerProvider
            - Shared\Tests\Faker\DocumentFakerProvider
            - Shared\Tests\Faker\DossierFakerProvider
            - Shared\Tests\Faker\LandingPageFakerProvider
            - Shared\Tests\Faker\FileFakerProvider
            - Shared\Tests\Faker\UuidFakerProvider
    ignoreErrors:
        - identifier: missingType.generics

services:
    errorFormatter.junit:
        class: PHPStan\Command\ErrorFormatter\JUnitErrorFormatter
    -
        class: Utils\PHPStan\Rules\DontUseShouldReceiveRule
        tags:
            - phpstan.rules.rule
    -
        class: Utils\PHPStan\Rules\RequireExplicitArrayKeyTypeRule
        tags:
            - phpstan.rules.rule
