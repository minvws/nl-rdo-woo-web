meta {
  name: Get Organisation
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/organisation
  body: none
  auth: inherit
}

script:post-response {
  const data = res.getBody();
  const items = data.items;
  
  const org = items.find(item => item.name === "E2E Test Organisation");
  
  if (org) {
    bru.setVar("organisationId", org.id);
  } else if (items.length > 0) {
    console.warn('Set the first organisation found instead of "E2E Test Organisation"');
    bru.setVar("organisationId", items[0].id);
  } else {
    throw new Error("E2E Test Organisation not found, variable could not be set");
  }
}
