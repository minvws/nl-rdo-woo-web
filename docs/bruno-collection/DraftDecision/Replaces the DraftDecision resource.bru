meta {
  name: Replaces the DraftDecision resource.
  type: http
  seq: 3
  tags: [
    DraftDecision
  ]
}

put {
  url: {{baseUrl}}/organisation/:organisationId/dossiers/draft-decision/external/:dossierExternalId
  body: json
  auth: inherit
}

params:path {
  organisationId: {{organisationId}}
  dossierExternalId: {{draftDecisionDossierExternalId}}
}

body:json {
  {
    "departmentId":  "{{departmentId}}",
    "mainDocument": {
      "fileName": "main-document.pdf",
      "formalDate": "2026-02-01",
      "language": "NLD",
      "type": "c_33d7570c"
    },
    "subjectId": "{{subjectId}}",
    "summary": "Summary of the draft decision",
    "title": "Bruno - Draft decision",
    "attachments": [
      {
        "fileName": "attachment.pdf",
        "formalDate": "2026-02-01",
        "language": "NLD",
        "type": "c_a40458df",
        "externalId": "{{draftDecisionAttachmentExternalId}}"
      }
    ],
    "dossierDate": "2025-01-01",
    "dossierNumber": "bruno-{{sessionTimestamp}}",
    "publicationDate": "2026-02-01"
  }
}

script:pre-request {
  if (bru.isSafeMode()) {
    throw new Error("Enable develop mode to support the scripts");
  }

  const crypto = require('crypto');

  if (!bru.getVar("draftDecisionDossierExternalId")) {
    bru.setVar("draftDecisionDossierExternalId", crypto.randomUUID());
  }
  if (!bru.getVar("draftDecisionAttachmentExternalId")) {
    bru.setVar("draftDecisionAttachmentExternalId", crypto.randomUUID());
  }
}

docs {
  Replaces the DraftDecision resource.

  Documents of this publication type may not be redacted, so the main document
  and attachments have no `grounds` property. The main document is required and
  must be of type `c_33d7570c` (legislative proposal). At least one attachment
  of type `c_a40458df` (request for advice) or `c_10eb451d` (policy document)
  is required.
}

