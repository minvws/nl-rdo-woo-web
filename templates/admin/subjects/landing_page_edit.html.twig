{% extends 'admin/base.html.twig' %}

{% set page_title = 'admin.subject.edit_landing_page' | trans({'name': subject.name}) %}

{% block body %}
{{ form_start(form) }}
{% set submit_button %}{{ form_widget(form.submit) }}{% endset %}
<div class="bhr-container bhr-container--sm">
    <h1 class="bhr-title mb-10">{{ page_title }}</h1>

    <div class="bhr-card">
        {{ form_row(form.landing_page_status) }}
        {{ form_row(form.landing_page_slug) }}
        {{ form_row(form.landing_page_title) }}
        {{ form_row(form.landing_page_description) }}

        {{ submit_button }}
    </div>
</div>

<div class="mt-12">
    <div class="bhr-container">
        <h2 class="bhr-title-sm">{{ 'admin.subject.landing_page.content_tree.section' | trans }}</h2>
        <p class="mt-2 mb-4 bhr-readable-width">{{ 'admin.subject.landing_page.content_tree_info' | trans }}</p>

        <div class="grid grid-cols-5 gap-4">
            <div class="col-span-3">
                <div class="bhr-card">
                    <p class="mb-6">{{ 'admin.subject.landing_page.content_tree_manage' | trans }}</p>

                    {{ form_row(form.has_visible_landing_page_content_tree) }}
                    {{ form_row(form.landing_page_content_tree) }}

                    {{ submit_button }}
                </div>
            </div>

            <div class="col-span-2 sticky top-0 self-start">
                <div class="bhr-card" {{ vue_component('GenericController', {
                    componentName: 'ContentTreePreview',

                    treeId: form.landing_page_content_tree.vars.id,
                }) }}></div>
            </div>
        </div>
    </div>
</div>
{{ form_end(form) }}
{% endblock %}
