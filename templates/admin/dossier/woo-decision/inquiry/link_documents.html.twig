{% extends 'admin/base.html.twig' %}

{% set page_title = 'admin.dossiers.link_documents' | trans() %}

{% block body %}
    <h1 class="bhr-title bhr-title--fixed-width mx-auto mb-10">{{ page_title }}</h1>
    <div class="bhr-container bhr-container--sm">
        {% if result is not null %}
            {% if result.hasMatter %}
                <div class="bhr-card" data-e2e-name="link-documents-matter-deprecated">
                    <twig:Admin:Alert type="warning">
                        {{ 'admin.inquiries.matter_deprecated' | trans }}
                    </twig:Admin:Alert>
                </div>
            {% endif %}
            <div class="bhr-card" data-e2e-name="alerts">
                <twig:Admin:Alert type="{{ result.isSuccessful ? 'success' : 'warning' }}">
                    <p class="font-bold">{{ 'admin.inquiries.number_of_inquiries_added' | trans({'count': result.addedRelationsCount}) }}</p>

                    <twig:block name="extra">
                        {% if result.hasGenericErrors %}
                            <p class="font-bold">{{ 'admin.inquiries.generic_errors_title' | trans }}:</p>

                            <ul class="bhr-ul">
                                {% for error in result.genericErrors %}
                                    <li class="bhr-li">{{ error | trans }}</li>
                                {% endfor %}
                            </ul>
                        {% endif %}

                        {% if result.hasRowErrors %}
                            <p class="font-bold {{ result.hasGenericErrors ? 'mt-4' : '' }}">{{ 'admin.inquiries.row_errors_title' | trans }}:</p>

                            <ul class="bhr-ul">
                                {% for rownumber, rowErrors in result.rowErrors %}
                                    {% for error in rowErrors %}
                                        <li class="bhr-li">{{ 'admin.inquiries.row' | trans }} {{ rownumber }}: {{ error | trans }}</li>
                                    {% endfor %}
                                {% endfor %}
                            </ul>
                        {% endif %}
                    </twig:block>
                </twig:Admin:Alert>
            </div>
        {% endif %}
        <div class="bhr-card">
            {{ form_start(link_documents) }}
            {{ form_errors(link_documents) }}
            {{ form_row(link_documents.upload) }}
            {{ form_row(link_documents.link) }}
            {{ form_row(link_documents.cancel) }}
            {{ form_end(link_documents) }}
        </div>
    </div>
{% endblock %}
