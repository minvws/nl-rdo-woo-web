{% extends 'public/search/entries/base.html.twig' %}

{% set resultUrl = path('app_draftdecision_detail', { documentPrefix: entry.dossier.documentPrefix, dossierNumber: entry.dossier.dossierNumber }) %}
{% set resultType = 'dossier.type.draft-decision' | trans %}

{% block resultSpecsBottom %}
    <li class="woo-search-result__spec">
        {{ 'public.dossiers.request-for-advice.date' | trans }} <twig:Date date="{{ entry.dossier.date }}" />
    </li>
    <li class="woo-search-result__spec">
        {{ 'global.published_on' | trans | capitalize }} <twig:Date date="{{ entry.dossier.publicationDate }}" />
    </li>
{% endblock %}
